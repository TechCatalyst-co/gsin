# ---- server config ----
PORT=4000
# Web app origin: CORS, Stripe return URLs, RSS/sitemap links.
CLIENT_URL=http://localhost:5173

# ---- brand (used in RSS titles) ----
BRAND_NAME=Singularity Wire
BRAND_TAGLINE=Daily news on artificial intelligence and the road to superintelligence.

# ---- database ----
# The database name in the path is REQUIRED (the server refuses to start without it).
MONGODB_URI=mongodb://localhost:27017/singularity-wire

# ---- auth ----
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# ---- n8n (shared secret sent as the x-api-key header) ----
API_KEY=replace-with-a-long-random-string

# ---- access policy ----
# true = free accounts may post comments too (default: Premium only)
COMMENTS_FREE=false

# ---- stripe (Premium membership) ----
STRIPE_SECRET_KEY=sk_test_xxx
# Recurring Premium price (starts with price_)
STRIPE_PRICE_ID_PREMIUM=price_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
