# ---- server config ----
PORT=4000
# Web app origin: CORS and RSS/sitemap links.
CLIENT_URL=http://localhost:5173

# ---- brand (used in RSS titles) ----
BRAND_NAME=Global Super Intelligence News
BRAND_SHORT=GSIN
BRAND_TAGLINE=News on artificial intelligence and the road to superintelligence, from around the world.

# ---- database ----
# The database name in the path is REQUIRED (the server refuses to start without it).
MONGODB_URI=mongodb://localhost:27017/gsin

# ---- auth ----
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# ---- n8n (shared secret sent as the x-api-key header) ----
API_KEY=replace-with-a-long-random-string
