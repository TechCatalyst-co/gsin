# ---- server config ----
PORT=4000
# Web app origin: CORS and RSS/sitemap links.
CLIENT_URL=http://localhost:5173

# ---- brand (used in RSS titles) ----
BRAND_NAME=Global Super Intelligence News
BRAND_SHORT=GSIN
BRAND_TAGLINE=News on artificial intelligence and the road to superintelligence, from around the world.

# ---- database ----
# The database name in the path is REQUIRED (the server refuses to start without it).
MONGODB_URI=mongodb://localhost:27017/gsin

# ---- auth ----
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# ---- n8n (shared secret sent as the x-api-key header) ----
API_KEY=replace-with-a-long-random-string

# ---- breaking-news push (optional) ----
# Firebase service-account JSON (raw, or base64 of the file). Leave empty to
# turn push off. Firebase console → Project settings → Service accounts.
FIREBASE_SERVICE_ACCOUNT=
# FCM topic the app subscribes to. Use e.g. breaking-dev on a dev server so
# test alerts don't reach real readers (the app must use the same topic).
PUSH_TOPIC=breaking
# Topic for the twice-daily "brief is out" push (Global SI morning + evening).
PUSH_BRIEF_TOPIC=brief

# ---- Global SI radar ----
# Number of sources the radar sweeps, shown in the live status strip.
RADAR_SOURCE_COUNT=44
